#!/bin/bash
#SBATCH --job-name=guppy_gpu
#SBATCH --output=guppy_gpu.%j.out
#SBATCH --error=guppy_gpu.%j.err
#SBATCH --time=24:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=8
#SBATCH --partition=gpu
#SBATCH --gres=gpu
#SBATCH --mem=20GB

module purge
module load guppy-gpu/6.5

# input files are taken from https://github.com/nanoporetech/ont_fast5_api/tree/master/test/data/hardlink/single_reads
# replace the values for input_path, save_path, flowcell, and kit with your real data
guppy_basecaller \
	--input_path $PWD/input/ \
	--save_path $PWD/guppy_gpu \
	--flowcell FLO-MIN106 \
	--kit SQK-LSK109 \
	--device "auto" \
        --num_callers ${SLURM_NTASKS_PER_NODE}
