#!/bin/bash
#SBATCH --job-name=dorado_gpu
#SBATCH --output=dorado_gpu.%j.out
#SBATCH --error=dorado_gpu.%j.err
#SBATCH --time=01:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=8
#SBATCH --constraint='gpu_v100|gpu_t4'
#SBATCH --partition=gpu
#SBATCH --gres=gpu:2
#SBATCH --mem=20GB

module load apptainer

# input file is used from https://github.com/nanoporetech/dorado/blob/release-v2.1/tests/data/pod5/dna_r10.4.1_e8.2_400bps_4khz/dna_r10.4.1_e8.2_400bps_4khz-FLO_FLG114-SQK_PCB114_24-4000.pod5
# supported GPU platforms
# https://github.com/nanoporetech/dorado#platforms

# please download the appropriate module, e.g.,:
apptainer exec docker://nanoporetech/dorado:sha4644018526d3644d92a9e680ab8f2d1eeff2e272 dorado download --model dna_r10.4.1_e8.2_400bps_hac@v4.1.0

# run basecaller
# replace model, input and output files accordingly
apptainer exec docker://nanoporetech/dorado:sha4644018526d3644d92a9e680ab8f2d1eeff2e272 dorado basecaller --device "cuda:all" \
    dna_r10.4.1_e8.2_400bps_hac@v4.1.0 data.pod5 > output_gpu_0.9.bam
